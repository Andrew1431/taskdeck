{
  "name": "taskdeck",
  "version": "0.1.6",
  "type": "module",
  "description": "A task runner for working with coding agents: one taskdeck.yaml of typed, risk-rated commands per repo, run from the CLI, a local UI, or your agent over MCP.",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andrew1431/taskdeck.git"
  },
  "bin": {
    "taskdeck": "./src/cli.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^5.5.0",
    "yaml": "^2.9.1"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "keywords": [
    "mcp",
    "ai",
    "agent",
    "tasks",
    "task-runner",
    "scripts",
    "cli",
    "developer-tools"
  ],
  "homepage": "https://github.com/Andrew1431/taskdeck#readme",
  "bugs": {
    "url": "https://github.com/Andrew1431/taskdeck/issues"
  },
  "files": [
    "src",
    "examples",
    "CONTRACT.md",
    "AGENT_SETUP.md"
  ]
}
